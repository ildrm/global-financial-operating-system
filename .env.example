# Development only. Generate .env with: pnpm env:init
NODE_ENV=development
GFOS_DEMO=true
POSTGRES_PASSWORD=generate-with-env-init
GFOS_RUNTIME_PASSWORD=generate-with-env-init
GFOS_WORKER_PASSWORD=generate-with-env-init
DATABASE_URL=postgresql://gfos_runtime:generated-password@127.0.0.1:55432/gfos
WORKER_DATABASE_URL=postgresql://gfos_background:generated-password@127.0.0.1:55432/gfos
MIGRATION_DATABASE_URL=postgresql://gfos_migrator:generated-password@127.0.0.1:55432/gfos
DEMO_API_TOKEN=generate-with-env-init
SESSION_SECRET=generate-with-env-init
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Real authentication: GFOS_DEMO=false; provision identities and grants.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
GARAGE_DEFAULT_ACCESS_KEY=generate-with-env-init
GARAGE_DEFAULT_SECRET_KEY=generate-with-env-init
GARAGE_DEFAULT_BUCKET=gfos-documents

